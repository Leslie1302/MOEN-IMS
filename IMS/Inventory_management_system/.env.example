# MOEN-IMS environment configuration (EXAMPLE)
# Copy to .env for local dev, or set these as Azure App Service application
# settings in production. NEVER commit a real .env. See HARDENING_PLAN.md.

# --- Core Django ---------------------------------------------------------
# 'true' only in local development. Leave unset/false in production.
DJANGO_DEBUG=true
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated https origins for CSRF (defaults cover the known hosts).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Force a single canonical host, e.g. www.moen-ims.org (optional).
CANONICAL_HOST=
COOKIE_DOMAIN=
# Comma-separated emails auto-promoted to superuser on Microsoft OAuth login.
# Bootstrap-only: set the recovery admin here, sign in once, then assign roles
# normally and clear this. Keep it in the environment, NEVER hardcoded in source.
TRUSTED_ADMIN_EMAILS=

# --- Database (PRODUCTION) ----------------------------------------------
# REQUIRED in production. PostgreSQL connection URL:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=True
# Emergency override ONLY. Do not use for concurrent multi-user production.
# ALLOW_SQLITE_IN_PROD=0

# --- Token encryption (M365 tokens) -------------------------------------
# REQUIRED in production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Microsoft 365 OAuth -------------------------------------------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
# Comma-separated emails auto-promoted to superuser on first login (recovery).
TRUSTED_ADMIN_EMAILS=

# --- Caching / scalability ----------------------------------------------
# Set in production (and required before scaling beyond one instance):
#   rediss://:PASSWORD@HOST:6380/0
REDIS_URL=

# --- Brute-force / rate limiting ----------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
AXES_PROXY_COUNT=1
RATELIMIT_ENABLE=True
# Per-endpoint limits (django-ratelimit rate strings, e.g. "10/m", "100/h").
# Guard heavy/abusable endpoints; defaults shown.
RATELIMIT_WAYBILL_PDF=10/m
RATELIMIT_BULK_UPLOAD=6/m
RATELIMIT_BULK_REQUEST=6/m

# --- Content Security Policy --------------------------------------------
# Leave unset to run CSP in report-only mode. Set to 1 to ENFORCE.
CSP_ENFORCE=

# --- Media storage (Azure Blob) -----------------------------------------
# When all three are set, user uploads (waybills, release letters, photos,
# etc.) are stored in Azure Blob instead of local disk, so they survive
# deploys/restarts and work across multiple instances. Leave blank in local
# dev to use the local `media/` folder.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
# Uploads are served via expiring SAS URLs (container is private). Seconds:
AZURE_URL_EXPIRATION_SECS=3600

# --- Error tracking ------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Email (password reset / notifications) -----------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MOEN IMS <noreply@moen-ims.org>
